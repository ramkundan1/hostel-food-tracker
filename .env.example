# Copy this file to .env and fill in real values.
# NEVER commit .env. Only this example file belongs in git.

# --- Database (Neon / PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- App ---
APP_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="e-tracker <no-reply@your-domain.example>"
SUPPORT_EMAIL="you@example.com"

# --- Cron (protects the daily auto-entry endpoint) ---
CRON_SECRET="replace-with-another-long-random-string"

# --- Admin (comma-separated emails) ---
ADMIN_EMAILS="you@example.com"

# --- Optional: Google Search Console verification token ---
GOOGLE_SITE_VERIFICATION=""
